---
// A page opened from the app's "Send the steps" carries
// ?utm_source=app&utm_campaign=share-<style id> in its address, and a page
// opened from a Pinterest pin carries
// ?utm_source=pinterest&utm_campaign=pin-<id>. This passes that campaign on
// to the page's store links, so App Store Connect and Play Console count an
// install from a shared page as share-<style id>, and one from a pin as
// pin-<id>, rather than as the page's own campaign.
//
// It only changes where the store links on this page point, for this one
// visit. No cookie, no storage, nothing sent anywhere: the stores see the
// campaign only if someone taps a store link, as with every other link on
// the site. Anything that isn't exactly one of those two campaigns is
// ignored.
---
<script is:inline>
  (function () {
    var params = new URLSearchParams(location.search);
    var source = params.get('utm_source');
    var name = params.get('utm_campaign') || '';
    var medium;
    if (source === 'app' && /^share-[a-z0-9-]{1,34}$/.test(name)) medium = 'share';
    else if (source === 'pinterest' && /^pin-[a-z0-9-]{1,36}$/.test(name)) medium = 'social';
    else return;
    var links = document.querySelectorAll('a[href^="https://apps.apple.com/"], a[href^="https://play.google.com/"]');
    for (var i = 0; i < links.length; i++) {
      var url = new URL(links[i].href);
      if (url.hostname === 'apps.apple.com') {
        url.searchParams.set('ct', name);
      } else {
        url.searchParams.set('referrer', 'utm_source=' + source + '&utm_medium=' + medium + '&utm_campaign=' + name);
      }
      links[i].href = url.toString();
    }
  })();
</script>
