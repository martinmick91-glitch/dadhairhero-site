---
// A seasonal guide (Halloween, Christmas): looks made from styles the app
// already has, described as looks and never as characters. Free styles
// lead, each with every step on its own page; then a toddler look beside
// the app's under-three line; then two looks from Beyond the Ponytail,
// marked as pack styles. The guide's own sentences, the looks and the Fix
// It answers it quotes are in its record in lib/site.js (HALLOWEEN,
// CHRISTMAS). No prices and no shop links here: things to buy are on the
// Kit page.
import Base from '../layouts/Base.astro';
import Look from './Look.astro';
import StoreBadges from './StoreBadges.astro';
import AppBlock from './AppBlock.astro';
import Author from './Author.astro';
import {
  US, UNDER_THREE_LINE, DECEMBER_MOMENTS, path, absolute, breadcrumbs, itemList,
  article, styleById, fixEntryById, fixNodeById, campaign, minutes, sentence, t,
} from '../lib/site.js';

const { locale, guide } = Astro.props;
const region = locale === US ? 'us' : 'uk';

const looks = guide.looks.map((look) => ({ ...look, style: styleById(locale, look.styleId) }));
const fixes = guide.fixes.map((fix) => ({ ...fix, outcome: fixNodeById(locale, fix.node), entry: fixEntryById(locale, fix.entry) }));
if (looks.some((look) => !look.style) || fixes.some((fix) => !fix.outcome || fix.outcome.type !== 'outcome' || !fix.entry)) {
  throw new Error(`${guide.segment}: a style or Fix It entry named for this guide is no longer in the export`);
}
// A free look must stay free and a pack look must be marked as one: if a
// style moves in or out of the pack, the build stops rather than mislabel it.
const misplaced = looks.find((look) => look.style.pack !== (look.section === 'pack'));
if (misplaced) throw new Error(`${guide.segment}: ${misplaced.styleId} is in the "${misplaced.section}" section but pack is ${misplaced.style.pack}`);
const free = looks.filter((look) => look.section === 'free');
const toddler = looks.filter((look) => look.section === 'toddler');
const pack = looks.filter((look) => look.section === 'pack');

const title = guide.title[region];
const description = guide.description[region];
const h1 = t(locale, guide.h1);
const trail = [
  { name: 'Home', path: path(locale, 'home') },
  { name: t(locale, 'Party hairstyles'), path: path(locale, 'party') },
  { name: t(locale, guide.name), path: path(locale, guide.kind) },
];
const jsonld = [
  article({
    headline: h1,
    description,
    image: absolute(guide.ogImage),
    datePublished: guide.datePublished,
    dateModified: guide.dateModified,
    url: absolute(path(locale, guide.kind)),
    locale,
  }),
  breadcrumbs(trail),
  // The free looks only: the ones a reader can follow from this site.
  itemList(h1, [...free, ...toddler].map((look) => ({ name: t(locale, look.heading), path: path(locale, 'style', look.styleId) }))),
];
---
<Base
  locale={locale}
  kind={guide.kind}
  title={title}
  description={description}
  trail={trail}
  jsonld={jsonld}
  ogImage={guide.ogImage}
  ogImageSize={guide.ogImageSize}
>
  <h1>{h1}</h1>
  <p class="lede">{guide.lede[region]}</p>
  <Author locale={locale} />
  <p class="summary-cta">{t(locale, guide.freeCount)}</p>
  <StoreBadges campaignName={campaign(locale, guide.kind)} />
  <p>{guide.intro[region]}</p>

  <ul class="rows">
    {looks.map((look) => (
      <li>
        <a href={`#${look.anchor}`}>{t(locale, look.heading)}</a>
        <span>{t(locale, `About ${minutes(look.style.targetMinutes)}.`)} {look.style.pack ? t(locale, 'In Beyond the Ponytail.') : t(locale, 'Free, every step.')}</span>
      </li>
    ))}
  </ul>

  {free.map((look) => <Look locale={locale} look={look} lastLabel={guide.lastLabel} />)}

  <h2>{t(locale, guide.toddlerHeading)}</h2>
  <p>
    {t(locale, guide.toddlerIntro)}{' '}
    <a href={path(locale, 'toddler')}>{t(locale, 'toddler hairstyles')}</a>.
  </p>
  {toddler.map((look) => <Look locale={locale} look={look} level="h3" lastLabel={guide.lastLabel} />)}
  <p class="panel">{UNDER_THREE_LINE}</p>

  <h2>{t(locale, 'More looks in Beyond the Ponytail')}</h2>
  <p>
    {t(locale, guide.packIntro)}
  </p>
  {pack.map((look) => <Look locale={locale} look={look} level="h3" lastLabel={guide.lastLabel} />)}

  {guide.appMoments && (
    <>
      <h2 id="december-in-the-app">{t(locale, 'December in the app')}</h2>
      <p>{t(locale, 'Through December, the Today screen in Dad Hair Hero has a card for the moment you are in, one at a time, worked out from your phone\'s own date. Each card names two or three styles from the list below that suit her and that you can open, and you can hide it until next year.')}</p>
      {DECEMBER_MOMENTS.map((moment) => (
        <>
          <h3>{moment.title}</h3>
          <p>
            <strong>{moment.from === moment.to ? `${moment.from} December` : `${moment.from} to ${moment.to} December`}.</strong>{' '}
            {t(locale, moment.line)}{' '}
            {t(locale, 'The styles it can suggest, in order:')}
          </p>
          <ul>
            {moment.styleIds.map((id) => styleById(locale, id)).map((style) => (
              <li><a href={path(locale, 'style', style.id)}>{style.name}</a>{style.pack ? t(locale, ' (Beyond the Ponytail)') : ''}</li>
            ))}
          </ul>
        </>
      ))}
    </>
  )}

  <h2>{t(locale, 'If it goes wrong')}</h2>
  <p>{t(locale, 'The answers are from Fix It, the app\'s troubleshooter.')}</p>
  {fixes.map((fix) => (
    <>
      <h3>{t(locale, fix.q)}</h3>
      <p><strong>{sentence(fix.outcome.title)}</strong> {fix.outcome.body}</p>
      <p class="small">{t(locale, 'More in Fix It:')} <a href={path(locale, 'fix', fix.entry.id)}>{fix.entry.label}</a></p>
    </>
  ))}

  <h2>{t(locale, 'What you need')}</h2>
  <p>
    {t(locale, 'Each style\'s page lists what it needs, and every item on those lists is on')}{' '}
    <a href={path(locale, 'kit')}>{t(locale, 'the Kit page')}</a>{t(locale, ', with what it is for and what to avoid.')}
  </p>

  <AppBlock locale={locale} kind={guide.kind} />

  <p class="small">
    {t(locale, guide.moreLead)} <a href={path(locale, 'party')}>{t(locale, 'party hairstyles')}</a>, {t(locale, 'or')}{' '}
    <a href={path(locale, 'styles')}>{t(locale, guide.allStyles)}</a>.
  </p>
</Base>
