---
// The home page. The copy is the approved 1.2.0 store listing text
// (docs/store-listings-1.2.md in the app's repository), written once in UK
// English and put through the app's glossary for the US page, with links
// into the guides.
import Base from '../../layouts/Base.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import StyleCards from '../../components/StyleCards.astro';
import {
  LOCALES, US, HUBS, SITE, EMAIL, APP_STORE_ID, PLAY_PACKAGE, langParam, localeFromParam, path, campaign, t,
  ORGANIZATION,
} from '../../lib/site.js';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: langParam(locale) } }));
}

const locale = localeFromParam(Astro.params.lang);
const free = locale.data.styles.filter((s) => !s.pack);
const screenshot = locale === US ? '/assets/screenshot-01-us.webp' : '/assets/screenshot-01.webp';

const title = 'Dad Hair Hero: Easy hairstyles for girls, step by step';
const description = t(locale, 'Step-by-step hairstyles for dads. Ponytails, bunches and more, timed for a school morning. Free on the App Store and Google Play.');

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Dad Hair Hero',
    url: `${SITE}${path(locale, 'home')}`,
    description: 'Hairstyles for girls, written for dads. Step by step, one picture at a time, and timed for a school morning.',
    operatingSystem: 'iOS, Android',
    applicationCategory: 'LifestyleApplication',
    inLanguage: ['en-GB', 'en-US'],
    image: `${SITE}/assets/icon-512.png`,
    screenshot: `${SITE}${screenshot}`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: locale.currency },
    installUrl: [
      `https://apps.apple.com/app/id${APP_STORE_ID}`,
      `https://play.google.com/store/apps/details?id=${PLAY_PACKAGE}`,
    ],
    publisher: { '@id': ORGANIZATION['@id'] },
  },
  { '@context': 'https://schema.org', ...ORGANIZATION },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Dad Hair Hero',
    url: `${SITE}/`,
    inLanguage: ['en-GB', 'en-US'],
    publisher: { '@id': ORGANIZATION['@id'] },
  },
];
---
<Base locale={locale} kind="home" title={title} description={description} jsonld={jsonld}>
  <div class="home-top">
    <div>
      <h1>Dad Hair Hero</h1>
      <p class="lede">
        {t(locale, 'Hairstyles for girls, written for dads. Step by step, one picture at a time, and timed for a school morning.')}
      </p>
      <p>{t(locale, 'Nobody taught you how to do her hair. This does.')}</p>
      <StoreBadges campaignName={campaign(locale, 'home')} />
    </div>
    <img
      class="screenshot"
      src={screenshot}
      width="540"
      height="960"
      fetchpriority="high"
      alt="Dad Hair Hero on a phone: step 1 of 6, Detangle first, with a picture of hair being combed from the ends up and the check “No catching from top to bottom”."
    />
  </div>

  <h2>{t(locale, 'How it works')}</h2>
  <p>
    {t(locale, 'Say how long you have (2, 5, 10 or 15 minutes and up) and what her hair is like today: straight, wavy, thick, curly or coily. The app picks a style that fits. Then it takes you through it one action at a time, with a picture of what your hands should be doing and a line that tells you what it should look and feel like before you move on.')}
  </p>

  <h2>{t(locale, 'Free, and it stays free')}</h2>
  <ul>
    <li>{t(locale, 'Six everyday styles: tangle-free brushing, a classic ponytail, a high ponytail, two even bunches, half-up half-down, and a clip-back for baby and toddler wisps.')}</li>
    <li>
      {t(locale, 'Eight')} <a href={path(locale, 'techniques')}>{t(locale, 'technique guides')}</a>{t(locale, ', including holding tension, detangling without tears, making a parting, choosing elastics and keeping her still.')}
    </li>
    <li>{t(locale, 'All the guidance for her hair type.')}</li>
    <li>
      <a href={path(locale, 'fixIt')}>Fix It</a>{t(locale, ": quick fixes for when something isn't right. It won't stay in, her hair is badly knotted, or she won't sit still.")}
    </li>
  </ul>
  <p>
    {t(locale, 'Ponytails and bunches are where most dads start, and each style says how long it takes. The quickest is one minute. All six are on this site in full, under')}
    {' '}<a href={path(locale, 'easy')}>{t(locale, 'easy hairstyles for girls')}</a>.
  </p>
  <StyleCards locale={locale} styles={free} />

  <h2>{t(locale, 'Find a style for the day')}</h2>
  <ul class="rows">
    {HUBS.map((hub) => (
      <li><a href={path(locale, hub.kind)}>{t(locale, hub.h1)}</a><span>{t(locale, hub.lede)}</span></li>
    ))}
  </ul>

  <h2>{t(locale, 'Curly and coily hair')}</h2>
  <p>
    {t(locale, 'Choose Curly or Coily under “her hair today” and the steps and pictures change to the method that suits curly hair: detangling it damp, working in sections, and keeping tension gentle at her edges. Three of the technique guides cover detangling curly and coily hair, the two-strand twist, and protecting her edges. All of it is free. Start with')}
    {' '}<a href={path(locale, 'curly')}>{t(locale, 'hairstyles for curly and coily hair')}</a>.
  </p>

  <h2>{t(locale, 'Beyond the Ponytail (optional)')}</h2>
  <p>{t(locale, 'When ponytails are easy and you want more, Beyond the Ponytail adds twelve styles in one pack:')}</p>
  <ul>
    <li>{t(locale, 'Plaits: a three-strand plait, a French plait, a Dutch plait, plaited pigtails and a pull-through plait.')}</li>
    <li>{t(locale, 'Buns: a top knot, a sports bun and space buns.')}</li>
    <li>{t(locale, 'And a bubble ponytail, puffs, twisted bunches and criss-cross bands.')}</li>
  </ul>
  <p>
    {t(locale, 'You pay once and the styles are yours to keep. There is no subscription. You can see every style in the pack, with its picture and its steps listed, before you decide.')}
    {' '}<a href={path(locale, 'styles')}>{t(locale, 'See all eighteen styles')}</a>.
  </p>

  <h2>{t(locale, 'The Kit')}</h2>
  <p>
    {t(locale, 'Eighteen things worth having, from a wide-tooth comb to a satin bonnet, sorted into Essential and Nice to have, with a photo of each and what it is for. The Buy links on the Kit screen are affiliate links, and the screen says so. Nothing is sold anywhere else in the app.')}
    {' '}<a href={path(locale, 'kit')}>{t(locale, 'See the Kit')}</a>.
  </p>

  <h2>{t(locale, 'Your diary')}</h2>
  <p>
    {t(locale, 'Add a photo and a note when you finish a style, and say how it went. The diary keeps a plain record: the styles you have done, how often, and what to try next. No points and no levels.')}
  </p>

  <h2>{t(locale, 'No account, no tracking')}</h2>
  <ul>
    <li>{t(locale, 'No sign-up and no account.')}</li>
    <li>{t(locale, 'No ads, no analytics and no tracking.')}</li>
    <li>{t(locale, "Your photos and notes are never sent to Dad Hair Hero. They are stored on your phone and are part of your phone's own backup, like any other app's data.")}</li>
    <li>{t(locale, 'Delete everything whenever you like, from the Privacy & data screen.')}</li>
  </ul>

  <h2>{t(locale, 'Who it is for')}</h2>
  <p>
    {t(locale, "Dads, and anyone else who does a girl's hair in the morning. The styles suit toddlers through to pre-teens. No experience is needed. The app is in UK or US English, whichever you choose.")}
    {' '}<a href={path(locale, 'about')}>{t(locale, 'About the dad who made it')}</a>.
  </p>
</Base>
