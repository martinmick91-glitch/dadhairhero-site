---
// Halloween: looks made from styles the app already has, described as looks
// and never as characters. Free styles lead, each with every step on its
// own page; then a toddler look beside the app's under-three line; then two
// looks from Beyond the Ponytail, marked as pack styles. The guide's own
// sentences, the looks and the Fix It answers it quotes are in HALLOWEEN in
// lib/site.js. No prices and no shop links here: things to buy are on the
// Kit page.
import Base from '../../layouts/Base.astro';
import Look from '../../components/Look.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import AppBlock from '../../components/AppBlock.astro';
import Author from '../../components/Author.astro';
import {
  LOCALES, US, HALLOWEEN, UNDER_THREE_LINE, langParam, localeFromParam, path, absolute, breadcrumbs, itemList,
  article, styleById, fixEntryById, fixNodeById, campaign, minutes, sentence, t,
} from '../../lib/site.js';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: langParam(locale) } }));
}

const locale = localeFromParam(Astro.params.lang);
const region = locale === US ? 'us' : 'uk';
const guide = HALLOWEEN;

const looks = guide.looks.map((look) => ({ ...look, style: styleById(locale, look.styleId) }));
const fixes = guide.fixes.map((fix) => ({ ...fix, outcome: fixNodeById(locale, fix.node), entry: fixEntryById(locale, fix.entry) }));
if (looks.some((look) => !look.style) || fixes.some((fix) => !fix.outcome || fix.outcome.type !== 'outcome' || !fix.entry)) {
  throw new Error('halloween: a style or Fix It entry named for this guide is no longer in the export');
}
// A free look must stay free and a pack look must be marked as one: if a
// style moves in or out of the pack, the build stops rather than mislabel it.
const misplaced = looks.find((look) => look.style.pack !== (look.section === 'pack'));
if (misplaced) throw new Error(`halloween: ${misplaced.styleId} is in the "${misplaced.section}" section but pack is ${misplaced.style.pack}`);
const free = looks.filter((look) => look.section === 'free');
const toddler = looks.filter((look) => look.section === 'toddler');
const pack = looks.filter((look) => look.section === 'pack');

const title = guide.title[region];
const description = guide.description[region];
const h1 = t(locale, guide.h1);
const trail = [
  { name: 'Home', path: path(locale, 'home') },
  { name: t(locale, 'Party hairstyles'), path: path(locale, 'party') },
  { name: t(locale, guide.name), path: path(locale, guide.kind) },
];
const jsonld = [
  article({
    headline: h1,
    description,
    image: absolute(guide.ogImage),
    datePublished: guide.datePublished,
    dateModified: guide.dateModified,
    url: absolute(path(locale, guide.kind)),
    locale,
  }),
  breadcrumbs(trail),
  // The free looks only: the ones a reader can follow from this site.
  itemList(h1, [...free, ...toddler].map((look) => ({ name: t(locale, look.heading), path: path(locale, 'style', look.styleId) }))),
];
---
<Base
  locale={locale}
  kind={guide.kind}
  title={title}
  description={description}
  trail={trail}
  jsonld={jsonld}
  ogImage={guide.ogImage}
  ogImageSize={guide.ogImageSize}
>
  <h1>{h1}</h1>
  <p class="lede">{guide.lede[region]}</p>
  <Author locale={locale} />
  <p class="summary-cta">{t(locale, 'The first four are free in the app, step by step.')}</p>
  <StoreBadges campaignName={campaign(locale, guide.kind)} />
  <p>{guide.intro[region]}</p>

  <ul class="rows">
    {looks.map((look) => (
      <li>
        <a href={`#${look.anchor}`}>{t(locale, look.heading)}</a>
        <span>{t(locale, `About ${minutes(look.style.targetMinutes)}.`)} {look.style.pack ? t(locale, 'In Beyond the Ponytail.') : t(locale, 'Free, every step.')}</span>
      </li>
    ))}
  </ul>

  {free.map((look) => <Look locale={locale} look={look} />)}

  <h2>{t(locale, 'Toddler Halloween hair')}</h2>
  <p>
    {t(locale, 'For a toddler with short, fine hair, start with the clip-back below; two even bunches suit toddlers too. More in')}{' '}
    <a href={path(locale, 'toddler')}>{t(locale, 'toddler hairstyles')}</a>.
  </p>
  {toddler.map((look) => <Look locale={locale} look={look} level="h3" />)}
  <p class="panel">{UNDER_THREE_LINE}</p>

  <h2>{t(locale, 'More looks in Beyond the Ponytail')}</h2>
  <p>
    {t(locale, 'These two are in Beyond the Ponytail, an optional one-time pack in the app. Each style\'s page shows the finished look, what you need and what the steps cover; the full steps, with a picture for each, are in the app.')}
  </p>
  {pack.map((look) => <Look locale={locale} look={look} level="h3" />)}

  <h2>{t(locale, 'If it goes wrong')}</h2>
  <p>{t(locale, 'The answers are from Fix It, the app\'s troubleshooter.')}</p>
  {fixes.map((fix) => (
    <>
      <h3>{t(locale, fix.q)}</h3>
      <p><strong>{sentence(fix.outcome.title)}</strong> {fix.outcome.body}</p>
      <p class="small">{t(locale, 'More in Fix It:')} <a href={path(locale, 'fix', fix.entry.id)}>{fix.entry.label}</a></p>
    </>
  ))}

  <h2>{t(locale, 'What you need')}</h2>
  <p>
    {t(locale, 'Each style\'s page lists what it needs, and every item on those lists is on')}{' '}
    <a href={path(locale, 'kit')}>{t(locale, 'the Kit page')}</a>{t(locale, ', with what it is for and what to avoid.')}
  </p>

  <AppBlock locale={locale} kind={guide.kind} />

  <p class="small">
    {t(locale, 'More for dressing up:')} <a href={path(locale, 'party')}>{t(locale, 'party hairstyles')}</a>, {t(locale, 'or')}{' '}
    <a href={path(locale, 'styles')}>{t(locale, 'all eighteen styles')}</a>.
  </p>
</Base>
