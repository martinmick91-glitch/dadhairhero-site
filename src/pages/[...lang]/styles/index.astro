---
// Every style: the six free ones, in full on this site, then the twelve in
// Beyond the Ponytail, as previews.
import Base from '../../../layouts/Base.astro';
import StyleCards from '../../../components/StyleCards.astro';
import AppCta from '../../../components/AppCta.astro';
import { LOCALES, langParam, localeFromParam, path, w, breadcrumbs, itemList } from '../../../lib/site.js';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: langParam(locale) } }));
}

const locale = localeFromParam(Astro.params.lang);
const free = locale.data.styles.filter((s) => !s.pack);
const pack = locale.data.styles.filter((s) => s.pack);
const plaits = w(locale, 'plaits', 'braids');
const bunches = w(locale, 'bunches', 'pigtails');

const trail = [
  { name: 'Home', path: path(locale, 'home') },
  { name: 'Styles', path: path(locale, 'styles') },
];
const title = `Hairstyles for girls: ponytails, ${plaits} and buns | Dad Hair Hero`;
const description = `Eighteen hairstyles for girls, written for dads. Six are free with every step and photo: ponytails, ${bunches} and more. Twelve more are in the app.`;
const entries = locale.data.styles.map((s) => ({ name: s.name, path: path(locale, 'style', s.id) }));
---
<Base
  locale={locale}
  kind="styles"
  title={title}
  description={description}
  trail={trail}
  jsonld={[breadcrumbs(trail), itemList('Hairstyles for girls', entries)]}
>
  <h1>Hairstyles for girls</h1>
  <p class="lede">
    Eighteen styles, written for dads. Each one says how long it takes and what you need.
  </p>

  <h2>Free styles, step by step</h2>
  <p>
    Six everyday styles, in full: every step, a photo of what your hands should be doing, and what to check
    before you move on. Ponytails and {bunches} are where most dads start.
  </p>
  <StyleCards locale={locale} styles={free} />

  <h2>Beyond the Ponytail</h2>
  <p>
    Twelve more styles, from {plaits} and buns to puffs and twists. Each page shows the finished look, how
    long it takes, what you need and what the steps cover. The full steps are in the app, in an optional
    one-time pack. There is no subscription.
  </p>
  <StyleCards locale={locale} styles={pack} />

  <AppCta locale={locale} kind="styles" heading="All eighteen, on your phone" />
</Base>
