---
// One style. A free style is the whole guide: every step, its photo, what
// to check, and the curly and coily version where the method differs. A
// Beyond the Ponytail style is a preview, as the app's locked style screen
// is: the finished look, time, kit and step titles. The export never writes
// a pack style's instructions, so there is nothing here to leak.
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import StyleCards from '../../../components/StyleCards.astro';
import SummaryCard from '../../../components/SummaryCard.astro';
import StoreBadges from '../../../components/StoreBadges.astro';
import AppBlock from '../../../components/AppBlock.astro';
import Author from '../../../components/Author.astro';
import Faq from '../../../components/Faq.astro';
import Related from '../../../components/Related.astro';
import Video from '../../../components/Video.astro';
import {
  LOCALES, langParam, localeFromParam, path, absolute, minutes, offersCurly, sentence, kitItemById,
  techniqueById, fixEntryById, pageTitle, pageDescription, breadcrumbs, imageUrl, lower, t, campaign,
  relatedStyles, techniquesUsed, hubsForStyle, styleFaq, faqPage, videoFor, AUTHORSHIP,
} from '../../../lib/site.js';

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    locale.data.styles.map((style) => ({
      params: { lang: langParam(locale), slug: style.slug },
      props: { id: style.id },
    })),
  );
}

const locale = localeFromParam(Astro.params.lang);
const { id } = Astro.props;
const style = locale.data.styles.find((s) => s.id === id);
const free = !style.pack;

const kit = style.equipmentIds.map((itemId) => kitItemById(locale, itemId)).filter(Boolean);
const curlyExtra = style.curlyOnly
  ? []
  : style.curlyEquipmentIds
      .filter((itemId) => !style.equipmentIds.includes(itemId))
      .map((itemId) => kitItemById(locale, itemId))
      .filter(Boolean);
const allKit = [...kit, ...curlyExtra];

const hasCurlySteps = free && style.steps.some((step) => step.curly);
const techniques = free ? techniquesUsed(locale, style) : [];
const related = relatedStyles(locale, style);
const hubs = hubsForStyle(locale, style);
const fixes = style.relatedFixIds.map((fixId) => fixEntryById(locale, fixId)).filter(Boolean);
const faq = free ? styleFaq(locale, style) : [];
const video = free ? videoFor(locale, style) : null;
const packStyles = locale.data.styles.filter((s) => s.pack && s.id !== style.id);

const title = free
  ? pageTitle(`${style.name}: step by step for dads | Dad Hair Hero`, `${style.name}, step by step | Dad Hair Hero`, `${style.name} | Dad Hair Hero`)
  : pageTitle(`${style.name}: what it is and what you need | Dad Hair Hero`, `${style.name}: what you need | Dad Hair Hero`, `${style.name} | Dad Hair Hero`);
const description = free
  ? pageDescription(
      `${style.name} in ${style.steps.length} steps, about ${minutes(style.targetMinutes)}.`,
      'A picture for every step and what to check before you move on.',
      'Written for dads.',
    )
  : pageDescription(
      `${style.name}: about ${minutes(style.targetMinutes)}, ${style.steps.length} steps.`,
      'See the finished look, what you need and what each step covers.',
      'The full steps are in the Dad Hair Hero app.',
    );

const trail = [
  { name: 'Home', path: path(locale, 'home') },
  { name: 'Styles', path: path(locale, 'styles') },
  { name: style.name, path: path(locale, 'style', style.id) },
];
const url = absolute(path(locale, 'style', style.id));

// Alt text says what the photo shows: the style, the step, whose hair.
const stepAlt = (step, i, curly) =>
  `${style.name}, step ${i + 1}${curly || style.curlyOnly ? ', curly hair' : ''}: ${lower(curly ? step.curly.title : step.title)}`;

const jsonld = [breadcrumbs(trail)];
const videoObject = video && {
  '@type': 'VideoObject',
  name: `${style.name}, step by step`,
  description: `Every step of ${lower(style.name)} from the Dad Hair Hero app, then the finished look. ${video.durationSeconds} seconds, no sound.`,
  thumbnailUrl: absolute(video.poster),
  contentUrl: absolute(video.src),
  uploadDate: video.uploadDate,
  duration: `PT${video.durationSeconds}S`,
  width: 1080,
  height: 1920,
  inLanguage: locale.code,
  ...AUTHORSHIP,
};
if (free) {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `${style.name}, step by step`,
    description: style.description,
    inLanguage: locale.code,
    image: imageUrl(style.image),
    totalTime: `PT${style.targetMinutes}M`,
    tool: kit.map((item) => ({ '@type': 'HowToTool', name: item.name })),
    step: style.steps.map((step, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: step.title,
      text: `${step.instruction} ${step.endState}`,
      image: imageUrl(step.photo),
      url: `${url}#step-${i + 1}`,
    })),
    ...(videoObject ? { video: videoObject } : {}),
    ...AUTHORSHIP,
  });
  jsonld.push(faqPage(faq));
  if (videoObject) jsonld.push({ '@context': 'https://schema.org', ...videoObject });
} else {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: style.name,
    description: style.description,
    inLanguage: locale.code,
    url,
    primaryImageOfPage: imageUrl(style.image),
    ...AUTHORSHIP,
  });
}
---
<Base
  locale={locale}
  kind="style"
  id={style.id}
  title={title}
  description={description}
  trail={trail}
  jsonld={jsonld}
  ogImage={`${style.image.base}-800.webp`}
  ogImageSize={{ width: style.image.width, height: style.image.height }}
>
  {!free && <p><span class="pack-tag">Beyond the Ponytail</span></p>}
  <h1>{style.name}</h1>
  <p class="lede">{sentence(style.oneLiner)}</p>
  <Author locale={locale} />
  <p class="summary-cta">{style.pack ? t(locale, 'Full steps in the free app, in Beyond the Ponytail.') : t(locale, 'Follow it step by step in the free app.')}</p>
  <StoreBadges campaignName={campaign(locale, 'style', style.id)} />

  <SummaryCard locale={locale} style={style} kit={kit} curlyExtra={curlyExtra} />

  <p>{style.description}</p>

  {style.curlyImage && (
    <figure class="photo hero-photo">
      <Photo photo={style.curlyImage} alt={`${style.name}, the finished style, curly hair: back view`} sizes="(max-width: 42rem) 80vw, 416px" />
      <figcaption>{t(locale, 'The same style on curly hair.')}</figcaption>
    </figure>
  )}

  {style.herJob && (
    <>
      <h2>{t(locale, 'Her job')}</h2>
      <p>{style.herJob}</p>
    </>
  )}

  {free ? (
    <>
      {video && (
        <>
          <h2>{t(locale, `See the steps in ${video.durationSeconds} seconds`)}</h2>
          <Video video={video} style={style} />
        </>
      )}

      <h2>{t(locale, 'The steps')}</h2>
      {hasCurlySteps && (
        <p>
          {t(locale, 'Where the method changes for curly and coily hair, the step says so underneath. In the app, choose Curly or Coily under “her hair today” and you only see the steps for her hair.')}
        </p>
      )}
      <ol class="steps">
        {style.steps.map((step, i) => {
          const technique = step.techniqueId && techniqueById(locale, step.techniqueId);
          const curlyTechnique = step.curly?.techniqueId && techniqueById(locale, step.curly.techniqueId);
          return (
            <li id={`step-${i + 1}`}>
              <p class="step-number">{t(locale, `Step ${i + 1} of ${style.steps.length}`)}</p>
              <h3>{step.title}</h3>
              <p>{step.instruction}</p>
              {step.photo && (
                <figure class="photo">
                  <Photo photo={step.photo} alt={stepAlt(step, i, false)} />
                </figure>
              )}
              <div class="check">
                <p class="eyebrow">{t(locale, 'Before you move on')}</p>
                <p>{step.endState}</p>
              </div>
              {step.why && <p class="why"><strong>{t(locale, 'Why:')}</strong> {step.why}</p>}
              {technique && (
                <p class="small">{t(locale, 'Technique:')} <a href={path(locale, 'technique', technique.id)}>{technique.title}</a></p>
              )}
              {step.curly && (
                <div class="curly">
                  <p class="eyebrow">{t(locale, 'Curly and coily hair')}</p>
                  <h4>{step.curly.title}</h4>
                  <p>{step.curly.instruction}</p>
                  {step.curly.photo && step.curly.photo.base !== step.photo?.base && (
                    <figure class="photo">
                      <Photo photo={step.curly.photo} alt={stepAlt(step, i, true)} />
                    </figure>
                  )}
                  <p><strong>{t(locale, 'Before you move on:')}</strong> {step.curly.endState}</p>
                  {curlyTechnique && curlyTechnique.id !== technique?.id && (
                    <p class="small">{t(locale, 'Technique:')} <a href={path(locale, 'technique', curlyTechnique.id)}>{curlyTechnique.title}</a></p>
                  )}
                </div>
              )}
            </li>
          );
        })}
      </ol>

      {style.commonFailure && style.theFix && (
        <>
          <h2>{t(locale, 'If it goes wrong')}</h2>
          <div class="panel">
            <p><strong>{t(locale, 'What usually happens:')}</strong> {style.commonFailure}</p>
            <p><strong>{t(locale, 'The fix:')}</strong> {style.theFix}</p>
            {fixes.length > 0 && (
              <p>
                {t(locale, 'More in Fix It:')}{' '}
                {fixes.map((f, i) => <>{i > 0 && ' · '}<a href={path(locale, 'fix', f.id)}>{f.label}</a></>)}
              </p>
            )}
          </div>
        </>
      )}

      <Faq faq={faq} heading={t(locale, 'Common questions')} />

      <AppBlock locale={locale} kind="style" id={style.id} />
    </>
  ) : (
    <>
      <h2>{t(locale, 'What the steps cover')}</h2>
      <ol class="titles">
        {style.steps.map((step) => <li>{step.title}</li>)}
      </ol>
      <p>
        {t(locale, 'The full steps, with a picture for each and what to check before you move on, are in the app, in Beyond the Ponytail')}{offersCurly(style) && !style.curlyOnly ? t(locale, ', with the curly and coily method where it differs') : ''}.
      </p>

      <AppBlock locale={locale} kind="style" id={style.id} heading="Full steps in the app">
        <p>
          {t(locale, 'Beyond the Ponytail is an optional one-time pack of twelve styles in the Dad Hair Hero app. You pay once and they are yours to keep. There is no subscription, and you can see every style in the pack before you decide. Once it is yours, the app does four things this page cannot:')}
        </p>
      </AppBlock>
    </>
  )}

  <Related locale={locale} techniques={techniques} styles={related} hubs={hubs} kit={allKit} fixes={free ? [] : fixes} />

  {!free && (
    <>
      <h2>{t(locale, 'Also in Beyond the Ponytail')}</h2>
      <StyleCards locale={locale} styles={packStyles} />
    </>
  )}
</Base>
