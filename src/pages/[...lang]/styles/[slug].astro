---
// One style. A free style is the whole guide: every step, its photo, what
// to check, and the curly and coily version where the method differs. A
// Beyond the Ponytail style is a preview, as the app's locked style screen
// is: the finished look, time, kit and step titles. The export never writes
// a pack style's instructions, so there is nothing here to leak.
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import StyleCards from '../../../components/StyleCards.astro';
import AppCta from '../../../components/AppCta.astro';
import {
  LOCALES, langParam, localeFromParam, path, absolute, w, minutes, ages, hairTypes, hairLength, difficulty,
  offersCurly, sentence, kitItemById, techniqueById, pageTitle, pageDescription, breadcrumbs, imageUrl, list, lower,
} from '../../../lib/site.js';

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    locale.data.styles.map((style) => ({
      params: { lang: langParam(locale), slug: style.slug },
      props: { id: style.id },
    })),
  );
}

const locale = localeFromParam(Astro.params.lang);
const { id } = Astro.props;
const style = locale.data.styles.find((s) => s.id === id);
const free = !style.pack;

const kit = style.equipmentIds.map((itemId) => kitItemById(locale, itemId)).filter(Boolean);
const curlyExtra = style.curlyOnly
  ? []
  : style.curlyEquipmentIds
      .filter((itemId) => !style.equipmentIds.includes(itemId))
      .map((itemId) => kitItemById(locale, itemId))
      .filter(Boolean);

const freeStyles = locale.data.styles.filter((s) => !s.pack && s.id !== style.id);
const packStyles = locale.data.styles.filter((s) => s.pack && s.id !== style.id);
const hasCurlySteps = free && style.steps.some((step) => step.curly);

const title = free
  ? pageTitle(`${style.name}: step by step for dads | Dad Hair Hero`, `${style.name}, step by step | Dad Hair Hero`, `${style.name} | Dad Hair Hero`)
  : pageTitle(`${style.name}: what it is and what you need | Dad Hair Hero`, `${style.name}: what you need | Dad Hair Hero`, `${style.name} | Dad Hair Hero`);
const description = free
  ? pageDescription(
      `${style.name} in ${style.steps.length} steps, about ${minutes(style.targetMinutes)}.`,
      'A photo for every step and what to check before you move on.',
      'Written for dads.',
    )
  : pageDescription(
      `${style.name}: about ${minutes(style.targetMinutes)}, ${style.steps.length} steps.`,
      'See the finished look, what you need and what each step covers.',
      'The full steps are in the Dad Hair Hero app.',
    );

const trail = [
  { name: 'Home', path: path(locale, 'home') },
  { name: 'Styles', path: path(locale, 'styles') },
  { name: style.name, path: path(locale, 'style', style.id) },
];
const url = absolute(path(locale, 'style', style.id));

const jsonld = [breadcrumbs(trail)];
if (free) {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: `${style.name}, step by step`,
    description: style.description,
    inLanguage: locale.code,
    image: imageUrl(style.image),
    totalTime: `PT${style.targetMinutes}M`,
    tool: kit.map((item) => ({ '@type': 'HowToTool', name: item.name })),
    step: style.steps.map((step, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: step.title,
      text: `${step.instruction} ${step.endState}`,
      image: imageUrl(step.photo),
      url: `${url}#step-${i + 1}`,
    })),
  });
} else {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: style.name,
    description: style.description,
    inLanguage: locale.code,
    url,
    primaryImageOfPage: imageUrl(style.image),
  });
}

const packLine = `Beyond the Ponytail is an optional one-time pack of twelve styles in the Dad Hair Hero app. You pay once and they are yours to keep. There is no subscription.`;
---
<Base
  locale={locale}
  kind="style"
  id={style.id}
  title={title}
  description={description}
  trail={trail}
  jsonld={jsonld}
  ogImage={`${style.image.base}-800.webp`}
  ogImageSize={{ width: style.image.width, height: style.image.height }}
>
  {!free && <p><span class="pack-tag">Beyond the Ponytail</span></p>}
  <h1>{style.name}</h1>
  <p class="lede">{sentence(style.oneLiner)}</p>
  <p>{style.description}</p>

  <dl class="facts">
    <div><dt>Time</dt><dd>About {minutes(style.targetMinutes)}</dd></div>
    <div><dt>Steps</dt><dd>{style.steps.length}</dd></div>
    <div><dt>Level</dt><dd>{difficulty(style)}</dd></div>
    <div><dt>Ages</dt><dd>{ages(style)}</dd></div>
    <div><dt>Hair type</dt><dd>{hairTypes(locale, style)}</dd></div>
    <div><dt>Hair length</dt><dd>{hairLength(style)}</dd></div>
  </dl>

  <div class="looks">
    <figure>
      <Photo photo={style.image} alt={`${style.name}, the finished style${style.curlyOnly ? ' on curly hair' : ''}`} eager />
      <figcaption>The finished look{style.curlyImage ? '.' : style.curlyOnly ? ', on curly hair.' : '.'}</figcaption>
    </figure>
    {style.curlyImage && (
      <figure>
        <Photo photo={style.curlyImage} alt={`${style.name}, the finished style on curly hair`} />
        <figcaption>The same style on curly hair.</figcaption>
      </figure>
    )}
  </div>

  <h2>You'll need</h2>
  <ul>
    {kit.map((item) => <li><a href={path(locale, 'kitItem', item.id)}>{item.name}</a></li>)}
  </ul>
  {curlyExtra.length > 0 && (
    <p>
      For curly and coily hair, also:{' '}
      {curlyExtra.map((item, i) => (
        <>{i > 0 && ', '}<a href={path(locale, 'kitItem', item.id)}>{lower(item.name)}</a></>
      ))}.
    </p>
  )}

  {style.herJob && (
    <>
      <h2>Her job</h2>
      <p>{style.herJob}</p>
    </>
  )}

  {free ? (
    <>
      <h2>The steps</h2>
      {hasCurlySteps && (
        <p>
          Where the method changes for curly and coily hair, the step says so underneath. In the app, choose
          Curly or Coily under “her hair today” and you only see the steps for her hair.
        </p>
      )}
      <ol class="steps">
        {style.steps.map((step, i) => {
          const technique = step.techniqueId && techniqueById(locale, step.techniqueId);
          const curlyTechnique = step.curly?.techniqueId && techniqueById(locale, step.curly.techniqueId);
          return (
            <li id={`step-${i + 1}`}>
              <p class="step-number">Step {i + 1} of {style.steps.length}</p>
              <h3>{step.title}</h3>
              <p>{step.instruction}</p>
              {step.photo && (
                <figure class="photo">
                  <Photo photo={step.photo} alt={`${style.name}, step ${i + 1}: ${lower(step.title)}${style.curlyOnly ? ', on curly hair' : ''}`} />
                </figure>
              )}
              <div class="check">
                <p class="eyebrow">Before you move on</p>
                <p>{step.endState}</p>
              </div>
              {step.why && <p class="why"><strong>Why:</strong> {step.why}</p>}
              {technique && (
                <p class="small">Technique: <a href={path(locale, 'technique', technique.id)}>{technique.title}</a></p>
              )}
              {step.curly && (
                <div class="curly">
                  <p class="eyebrow">Curly and coily hair</p>
                  <h4>{step.curly.title}</h4>
                  <p>{step.curly.instruction}</p>
                  {step.curly.photo && step.curly.photo.base !== step.photo?.base && (
                    <figure class="photo">
                      <Photo photo={step.curly.photo} alt={`${style.name}, step ${i + 1} on curly hair: ${lower(step.curly.title)}`} />
                    </figure>
                  )}
                  <p><strong>Before you move on:</strong> {step.curly.endState}</p>
                  {curlyTechnique && curlyTechnique.id !== technique?.id && (
                    <p class="small">Technique: <a href={path(locale, 'technique', curlyTechnique.id)}>{curlyTechnique.title}</a></p>
                  )}
                </div>
              )}
            </li>
          );
        })}
      </ol>

      {style.commonFailure && style.theFix && (
        <>
          <h2>If it goes wrong</h2>
          <div class="panel">
            <p><strong>What usually happens:</strong> {style.commonFailure}</p>
            <p><strong>The fix:</strong> {style.theFix}</p>
          </div>
        </>
      )}

      <AppCta locale={locale} kind="style" id={style.id} />

      <h2>More free styles</h2>
      <StyleCards locale={locale} styles={freeStyles} />
    </>
  ) : (
    <>
      <h2>What the steps cover</h2>
      <ol class="titles">
        {style.steps.map((step) => <li>{step.title}</li>)}
      </ol>
      <p>
        The full steps, with a photo for each and what to check before you move on, are in the app, in
        Beyond the Ponytail{offersCurly(style) && !style.curlyOnly ? ', with the curly and coily method where it differs' : ''}.
      </p>

      <AppCta locale={locale} kind="style" id={style.id} heading="Full steps in the app">
        <p>{packLine}</p>
        <p>
          The app itself is free, with six everyday styles, eight technique guides and no account. You can
          see every style in the pack before you decide.
        </p>
      </AppCta>

      <h2>Free styles, in full on this site</h2>
      <StyleCards locale={locale} styles={freeStyles} />

      <h2>Also in Beyond the Ponytail</h2>
      <StyleCards locale={locale} styles={packStyles} />
    </>
  )}
</Base>
