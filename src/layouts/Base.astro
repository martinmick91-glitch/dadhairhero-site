---
// The frame around every page: the head (title, description, canonical,
// hreflang, Open Graph, structured data), the header and the footer.
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '../styles/site.css';
import StoreBadges from '../components/StoreBadges.astro';
import { SITE, UK, US, LOCALES, APP_STORE_ID, EMAIL, absolute, alternates, campaign, path } from '../lib/site.js';

const {
  locale = UK,
  kind,
  id,
  title,
  description,
  // False for a page with no twin in the other language (privacy, 404).
  paired = true,
  pathname = paired ? path(locale, kind, id) : Astro.url.pathname,
  noindex = false,
  ogImage = '/assets/feature-graphic.png',
  ogImageSize = { width: 1024, height: 500 },
  jsonld = [],
  trail = [],
} = Astro.props;

const canonical = absolute(pathname);
const links = paired ? alternates(kind, id) : [];
const campaignName = campaign(locale, kind, id);
const other = locale === US ? UK : US;

const nav = [
  { kind: 'styles', label: 'Styles' },
  { kind: 'techniques', label: 'Techniques' },
  { kind: 'curly', label: 'Curly hair' },
  { kind: 'kit', label: 'Kit' },
];
---
<!doctype html>
<html lang={locale.code}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {links.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/assets/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dad Hair Hero" />
    <meta property="og:locale" content={locale.og} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}${ogImage}`} />
    <meta property="og:image:width" content={String(ogImageSize.width)} />
    <meta property="og:image:height" content={String(ogImageSize.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}${ogImage}`} />

    {jsonld.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="column bar">
        <a class="brand" href={path(locale, 'home')}>Dad Hair Hero</a>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a href={path(locale, item.kind)} aria-current={item.kind === kind ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="column">
      {trail.length > 1 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          {trail.map((crumb, i) => (
            i < trail.length - 1
              ? <><a href={crumb.path}>{crumb.name}</a><span aria-hidden="true"> › </span></>
              : <span aria-current="page">{crumb.name}</span>
          ))}
        </nav>
      )}
      <slot />
    </main>

    <footer class="site-footer">
      <div class="column">
        <p class="footer-lede">Nobody taught you how to do her hair. Dad Hair Hero does.</p>
        <p>The app is free on the App Store and Google Play. No account, no ads, no tracking.</p>
        <StoreBadges campaignName={campaignName} />
        <nav class="footer-links" aria-label="Footer">
          <a href={path(locale, 'easy')}>Easy hairstyles</a>
          <a href={path(locale, 'curly')}>Curly and coily hair</a>
          <a href={path(locale, 'styles')}>All styles</a>
          <a href={path(locale, 'techniques')}>Techniques</a>
          <a href={path(locale, 'kit')}>The Kit</a>
          <a href="/privacy/">Privacy policy</a>
        </nav>
        {paired && (
          <p class="language">
            This page is in {locale.label}.
            <a href={path(other, kind, id)} hreflang={other.code} lang={other.code}>Read it in {other.label}</a>
          </p>
        )}
        <p class="small">
          Questions: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>. Dad Hair Hero is an app for adults.
        </p>
      </div>
    </footer>
  </body>
</html>
